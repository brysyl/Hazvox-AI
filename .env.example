# Supabase Configuration
# Required for PostgreSQL database storage and Supabase Realtime subscriptions
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# AssemblyAI Configuration
# Required for AssemblyAI Voice Agent / Realtime Streaming Speech-to-Text and Tool Calling
ASSEMBLYAI_API_KEY="your_assemblyai_api_key_here"

# Gemini AI (Fallback / Enhanced semantic hazard classification)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
